{
  "name": "lismqq-bot",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "LismQQ-bot: bridge between natcat shell (OneBot v11 / QQ) and a pi-agent (pi-agent-core + pi-ai DeepSeek): QQ messages become agent prompts, agent replies go back to QQ.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/bridge.js",
    "self-test": "node src/self-test.js",
    "test": "node test/run-tests.mjs",
    "test:memory": "node test/memory-pool.test.mjs",
    "test:onebot": "node test/onebot.test.mjs",
    "test:pi-host": "node test/pi-host.test.mjs",
    "test:bridge": "node test/bridge.test.mjs",
    "test:mcp": "node test/qq-tools-server.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "typebox": "1.3.27"
  }
}
